rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "G1mGfJJAqhgPQmImaNOUDHfibk92";
    }

    match /artifacts/{appId}/public/data/services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /artifacts/{appId}/public/data/promotions/{promotionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /artifacts/{appId}/public/data/config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
